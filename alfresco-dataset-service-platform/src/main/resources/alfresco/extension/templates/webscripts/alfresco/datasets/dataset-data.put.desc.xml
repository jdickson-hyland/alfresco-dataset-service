<webscript>
    <shortname>Set Dataset Element</shortname>
    <description>Sets/replaces the value at the given dot-notation field path from {value:...}; creates a new version</description>
    <url>/alfresco/datasets/{datasetName}/data</url>
    <url>/alfresco/datasets/{datasetName}/data?field={field}</url>
    <format default="json">extension</format>
    <authentication>admin</authentication>
    <transaction allow="readwrite">required</transaction>
    <family>Hyland Dataset Service</family>
</webscript>
